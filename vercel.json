{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "back-end": {
      "root": "Back-end",
      "framework": "express",
      "entrypoint": "app.js"
    },
    "front-end": {
      "root": "Front-end",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "back-end" }
    },
    {
      "source": "/uploads/(.*)",
      "destination": { "service": "back-end" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "front-end" }
    }
  ]
}
